# ---------------------------------------------------------------------------
# searchiq configuration. Copy to `.env` and edit:
#
#     cp .env.example .env        (Windows: copy .env.example .env)
#
# Every value has a working default, so an empty `.env` — or no `.env` at all —
# still produces a working system. Relative paths are resolved against the
# project root, not the working directory, so a command run from anywhere finds
# the same store.
#
# Secrets (the MySQL password, the Anthropic key) are read from the environment
# only. Nothing in this application ever writes them back to disk, and `.env` is
# in `.gitignore` — keep it there.
# ---------------------------------------------------------------------------

# --- Analytics store -----------------------------------------------------
# SQLite file built by `searchiq etl` (or `searchiq sample-data`) and read by
# everything else. Delete it and rebuild; it is never the source of truth.
SEARCHIQ_DB=data/searchiq.db

# --- Where the data comes from -------------------------------------------
# Three sources, in the order most people need them.
#
# 1. No data at all — generate some:
#        searchiq sample-data
#    Writes a mock mysqldump file here and loads it through the ordinary ETL.
#    It contains zero-result queries, misspellings, partial queries and
#    low-engagement terms, so every part of the dashboard has something to show.
SEARCHIQ_SAMPLE_DUMP_PATH=data/sample_dump.sql

# 2. The real extract — `searchiq etl` (the default) streams this mysqldump file
#    directly. No MySQL server and no credentials are needed. Point it at
#    wherever the .sql file actually is on this machine.
SEARCHIQ_DUMP_PATH=C:/Users/Osama/Downloads/grocery_database/spinneys_database.sql

# 3. A live database — `searchiq etl --source mysql` reads these instead. Fill
#    them in yourself; they are never written to disk by the application, and
#    the connector is an optional extra: pip install -e ".[mysql]"
SEARCHIQ_MYSQL_HOST=127.0.0.1
SEARCHIQ_MYSQL_PORT=3306
SEARCHIQ_MYSQL_USER=root
SEARCHIQ_MYSQL_PASSWORD=
SEARCHIQ_MYSQL_DATABASE=spinneys_database

# --- Search engine characteristics ---------------------------------------
# The production search returns at most this many results. Result sets smaller
# than the cap are "under-filled" and are treated as a retrieval shortfall, so
# setting this wrong shifts a headline metric — match it to the real engine.
SEARCHIQ_RESULT_CAP=5

# Gap (seconds) after which a new search is considered a new session. The source
# log has no session identifier, so sessions are derived from timing.
SEARCHIQ_SESSION_GAP_SECONDS=1800

# --- Agent and digest ----------------------------------------------------
# The agent (`searchiq ask`, POST /api/ask) and the digest narrative
# (`searchiq digest`, GET /api/digest) run on the Claude API when a key is set,
# and on a deterministic planner when it is not.
#
# WITHOUT A KEY  everything still works. Questions are routed by intent and
#                rendered from templates; the digest is assembled in full and
#                merely worded more plainly. Both paths read the same numbers,
#                through the same tools in `src/searchiq/agent/tools.py`, and
#                every answer says which path produced it.
#
# WITH A KEY     the agent runs a tool-calling loop, choosing among those same
#                tools and reporting the exact sequence it called.
#
# Get a key at https://console.anthropic.com/settings/keys — it looks like
# `sk-ant-...`. Leave it blank to stay offline; there is no partial mode.
ANTHROPIC_API_KEY=

# Model id for both the agent loop and the digest narrative. This is an API
# model identifier, not a path to a local file: nothing is downloaded and no
# model weights live on this machine. Any current Claude model id works —
# `claude-opus-5` (default, most capable), `claude-sonnet-5` (faster and
# cheaper), `claude-haiku-4-5-20251001` (cheapest).
SEARCHIQ_MODEL=claude-opus-5

# Inspect what the agent is actually bound to, with or without a key:
#     searchiq tools          (or: GET /api/agent/tools)
